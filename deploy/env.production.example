# Copiar a /var/www/facturacion/backend/.env antes del bootstrap o del primer deploy.
# cp deploy/env.production.example /var/www/facturacion/backend/.env

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECURE_SSL=true
SECURE_HSTS_SECONDS=31536000
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_MINIMO_40_CARACTERES_XYZ
ALLOWED_HOSTS=tudominio.cl,www.tudominio.cl,IP_DE_TU_VPS
CSRF_TRUSTED_ORIGINS=https://tudominio.cl,https://www.tudominio.cl
CORS_ALLOWED_ORIGINS=https://tudominio.cl,https://www.tudominio.cl

# --- Base de datos PostgreSQL ---
DB_NAME=facturacion1
DB_USER=facturacion_user
DB_PASSWORD=cambia_esta_contrasena
DB_HOST=localhost
DB_PORT=5432

# --- Correo (opcional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SSL_INSECURE=true
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL="Facturacion <tu_correo@gmail.com>"

# --- Frontend (npm run build) ---
VITE_API_URL=https://tudominio.cl
FRONTEND_BASE_URL=https://tudominio.cl

