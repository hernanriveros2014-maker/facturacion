# Copia este archivo a .env y completa los valores.
#   copy .env.example .env   (Windows)  |  cp .env.example .env  (Linux/Mac)
#
# --- Django (obligatorio) ---
SECRET_KEY=dev-only-facturacion-local-secret-key-min-40-chars-xx
DJANGO_DEBUG=true
#
# --- PostgreSQL (obligatorio) ---
# Local con Docker (docker-compose.dev.yml): user postgres, password tu_password, db facturacion1
DB_NAME=facturacion1
DB_USER=postgres
DB_PASSWORD=dev_local_pg_password_2024
DB_HOST=localhost
DB_PORT=5432
# Solo si DEBUG=false y sirves por HTTP local sin HTTPS:
# DJANGO_SECURE_SSL=false
#
# --- Correo (opcional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SSL_INSECURE=true
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=abcdefghijklmnop
DEFAULT_FROM_EMAIL="Facturacion <tu_correo@gmail.com>"
#
# URL pública del frontend (enlaces en correos).
# FRONTEND_BASE_URL=http://localhost:5173
#
# URL pública del backend.
# BACKEND_PUBLIC_URL=http://localhost:8000
#
# --- Odoo Online (emisión DTE) ---
# ODOO_URL=https://tu-empresa.odoo.com
# ODOO_DB=tu-empresa
# ODOO_USER=usuario@empresa.com
# ODOO_PASSWORD=
# ODOO_ENABLED=true
# ODOO_SSL_VERIFY=true
#
# Caché local (runserver): CACHE_BACKEND=locmem
